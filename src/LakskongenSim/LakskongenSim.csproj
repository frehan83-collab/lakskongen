<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\LakskongenSim.xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors> <!-- Missing XML comments -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- This is a pure C# library - NO Godot dependencies! -->

  <!--
    Phase A — Calibration Spine.
    Embed the canonical balancing data so the library, unit tests, headless tools
    and the exported game all load the SAME values with no working-directory
    assumptions. A live godot/data/calibration.json still takes precedence at
    runtime for hot-fixes/modding (see CalibrationRegistry.Load).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\godot\data\calibration.json"
                      Link="Calibration\calibration.json"
                      LogicalName="LakskongenSim.Calibration.calibration.json" />
  </ItemGroup>

</Project>