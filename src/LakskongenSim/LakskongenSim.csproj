<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\LakskongenSim.xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- Missing XML comments not enforced; XML doc file still generated for consumers -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- This is a pure C# library - NO Godot dependencies! -->

  <!--
    Phase A — Calibration Spine.
    Embed the canonical balancing data so the library, unit tests, headless tools
    and the exported game all load the SAME values with no working-directory
    assumptions. A live godot/data/calibration.json still takes precedence at
    runtime for hot-fixes/modding (see CalibrationRegistry.Load).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\godot\data\calibration.json"
                      Link="Calibration\calibration.json"
                      LogicalName="LakskongenSim.Calibration.calibration.json" />
    <!-- F2-04: the facilities include files (one per lane; CalibrationIncludes). -->
    <EmbeddedResource Include="..\..\godot\data\calibration\*.json"
                      Link="Calibration\Includes\%(Filename)%(Extension)"
                      LogicalName="LakskongenSim.Calibration.Includes.%(Filename)%(Extension)" />
    <!-- F2-03: the farm-type plots' gameplay attributes (SitePlotCatalog). -->
    <EmbeddedResource Include="..\..\godot\data\site_plots.json"
                      Link="Farm\site_plots.json"
                      LogicalName="LakskongenSim.Farm.site_plots.json" />
    <!-- U2-02: the first season's steps (TutorialSystem.Template). -->
    <EmbeddedResource Include="..\..\godot\data\tutorial_steps.json"
                      Link="Core\tutorial_steps.json"
                      LogicalName="LakskongenSim.Core.tutorial_steps.json" />
  </ItemGroup>

  <!--
    Geodata stage 2 (docs/geo/STAGE23_PLAN.md track A): the national map data the
    sim reads (Environment/Geo, GeoResources). Explicit names and an
    extension-specific glob only, never *.*: godot/data/geo also holds the
    Godot .import sidecars, which must not be embedded. Each file's SHA-256
    equals its godot/data/geo/manifest.json entry (GeoResourceParityTests).
  -->
  <ItemGroup Label="geo">
    <EmbeddedResource Include="..\..\godot\data\geo\candidates.json"
                      Link="Geo\candidates.json"
                      LogicalName="LakskongenSim.Geo.candidates.json" />
    <EmbeddedResource Include="..\..\godot\data\geo\production_areas.regional.geojson"
                      Link="Geo\production_areas.regional.geojson"
                      LogicalName="LakskongenSim.Geo.production_areas.regional.geojson" />
    <EmbeddedResource Include="..\..\godot\data\geo\suitability.json"
                      Link="Geo\suitability.json"
                      LogicalName="LakskongenSim.Geo.suitability.json" />
    <EmbeddedResource Include="..\..\godot\data\geo\suitability_rules.json"
                      Link="Geo\suitability_rules.json"
                      LogicalName="LakskongenSim.Geo.suitability_rules.json" />
    <EmbeddedResource Include="..\..\godot\data\geo\localities.geojson"
                      Link="Geo\localities.geojson"
                      LogicalName="LakskongenSim.Geo.localities.geojson" />
    <EmbeddedResource Include="..\..\godot\data\geo\suitability\po*.png"
                      Link="Geo\Suitability\%(Filename)%(Extension)"
                      LogicalName="LakskongenSim.Geo.Suitability.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>