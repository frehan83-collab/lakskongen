; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lakskongen"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/default_bus_layout="res://audio_bus_layout.tres"

[autoload]

LocalizationManager="*res://scripts/autoload/LocalizationManager.gd"
GameBridge="*res://scripts/autoload/GameBridge.cs"
EventBus="*res://scripts/autoload/EventBus.cs"
AudioManager="*res://scripts/autoload/AudioManager.cs"
SaveLoadManager="*res://scripts/autoload/SaveLoadManager.cs"
MultiplayerBridge="*res://scripts/autoload/MultiplayerBridge.cs"
SimBridge="*res://scripts/SimBridge.gd"
ToastNotification="*res://scripts/ui/ToastNotification.gd"
LakskongenTheme="*res://theme/default_theme.gd"
AudioController="*res://scripts/AudioController.gd"
MusicLibrary="*res://scripts/MusicLibrary.gd"
TutorialState="*res://scripts/autoload/TutorialState.gd"
ConsequenceDirector="*res://scripts/ui/ConsequenceDirector.gd"
AchievementManager="*res://scripts/autoload/AchievementManager.gd"
ScenarioManager="*res://scripts/ScenarioManager.gd"
TutorialManager="*res://scripts/tutorial/TutorialManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="LakskongenGame"

[internationalization]

locale/translations=PackedStringArray("res://translations/translations.en.translation", "res://translations/translations.nb.translation")
locale/test="no"

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
