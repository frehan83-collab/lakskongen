{
  "name": "lakskongen-design-tokens",
  "version": "2.0.0",
  "theme": "nordic-minimalist",
  "colors": {
    "primary": "#0A4D68",
    "primary-light": "#0D5F80",
    "primary-dark": "#083D53",
    "secondary": "#88C0D0",
    "secondary-light": "#A3D1DE",
    "accent": "#5E81AC",
    "accent-light": "#7B9BC0",
    "bg": "#ECEFF4",
    "bg-dark": "#2E3440",
    "surface": "#FFFFFF",
    "surface-elevated": "#F8F9FB",
    "surface-dark": "#3B4252",
    "text": "#2E3440",
    "text-secondary": "#4C566A",
    "text-muted": "#7B8794",
    "text-inverse": "#ECEFF4",
    "border": "#D8DEE9",
    "border-light": "#E5E9F0",
    "success": "#A3BE8C",
    "success-dark": "#8FAD78",
    "warning": "#EBCB8B",
    "warning-dark": "#D4B06A",
    "danger": "#BF616A",
    "danger-dark": "#A54E56",
    "info": "#88C0D0",
    "water-blue": "#5B8FA3",
    "salmon-pink": "#E5A09D",
    "fjord-teal": "#0A4D68"
  },
  "spacing": {
    "unit": 8,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radii": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "shadows": {
    "sm": "0 1px 2px rgba(46,52,64,0.06)",
    "md": "0 2px 4px rgba(46,52,64,0.1)",
    "lg": "0 4px 8px rgba(46,52,64,0.12)",
    "xl": "0 8px 16px rgba(46,52,64,0.15)"
  },
  "fonts": {
    "heading": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "body": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', monospace",
    "sizes": {
      "xs": 11,
      "sm": 13,
      "md": 15,
      "lg": 18,
      "xl": 24,
      "xxl": 32,
      "hero": 48
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "icons": {
    "sizes": [16, 20, 24, 32],
    "strokeWidth": 2,
    "style": "outline"
  },
  "grid": {
    "columns": 12,
    "gutter": 16,
    "margin": 24
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "xxl": 1536
  }
}
