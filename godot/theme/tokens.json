{
  "name": "lakskongen-design-tokens",
  "version": "3.0.0",
  "theme": "kyst-og-stal",
  "description": "Kyst & Stal (roadmap D13/D14): Ink glass for the HUD, the rail, world cards and toasts; Chart paper for document panels, opaque (base-alpha 1: the D13 ratios are computed on solid paper, and text on paper must not lean on what lies behind it). Inter with tabular figures for the UI, Barlow Condensed for display. Every text pair below is declared in contrast.pairs and checked by tests/test_theme_tokens.py.",
  "surfaces": {
    "ink": {
      "base": "#0B2A3A",
      "base-alpha": 0.9,
      "raised": "#13394B",
      "sunken": "#071F2B",
      "hairline": "#2C4650",
      "stroke": "#5B7D8C",
      "text": "#E8EEF0",
      "muted": "#9FB4BB",
      "ok": "#7FD69B",
      "warn": "#F2B705",
      "crit": "#FF8A80",
      "info": "#8CC7DA",
      "accent": "#F2876A",
      "focus": "#8CC7DA"
    },
    "chart": {
      "base": "#F4F1EA",
      "base-alpha": 1.0,
      "raised": "#FBFAF6",
      "sunken": "#EDE9E0",
      "hairline": "#D6CFBF",
      "stroke": "#8C8578",
      "text": "#1C1E20",
      "muted": "#5A6168",
      "ok": "#2E6B45",
      "warn": "#8A5A00",
      "crit": "#B3172F",
      "info": "#1F5E73",
      "accent": "#B5452B",
      "focus": "#1F5E73"
    }
  },
  "brand": {
    "salmon": "#F2876A",
    "salmon-hover": "#F59C83",
    "salmon-pressed": "#E97A5E",
    "salmon-deep": "#D9583B",
    "on-salmon": "#0B2A3A"
  },
  "landscape": {
    "granite": "#6B7378",
    "wet-rock": "#3E4448",
    "spruce": "#2F4A3A",
    "heath": "#8F9A5A",
    "snow": "#F4F7FA",
    "deep-water": "#0E2A33",
    "hdpe-black": "#1C1E20",
    "buoy-yellow": "#E8B92A"
  },
  "contrast": {
    "text-min": 4.5,
    "large-text-min": 3.0,
    "large-text-px": 24,
    "large-bold-text-px": 18,
    "non-text-min": 3.0,
    "pairs": [
      {"fg": "surfaces.ink.text", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: body text"},
      {"fg": "surfaces.ink.muted", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: secondary text"},
      {"fg": "surfaces.ink.ok", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: ok status text"},
      {"fg": "surfaces.ink.warn", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: warning status text"},
      {"fg": "surfaces.ink.crit", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: critical status text"},
      {"fg": "surfaces.ink.info", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: info text"},
      {"fg": "surfaces.ink.accent", "bg": "surfaces.ink.base", "min": 4.5, "use": "Ink: salmon accent text"},
      {"fg": "surfaces.ink.text", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: text on raised cards and buttons"},
      {"fg": "surfaces.ink.muted", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: secondary text on raised cards"},
      {"fg": "surfaces.ink.ok", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: ok text on raised cards"},
      {"fg": "surfaces.ink.warn", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: warning text on raised cards"},
      {"fg": "surfaces.ink.crit", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: critical text on raised cards"},
      {"fg": "surfaces.ink.info", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: info text on raised cards"},
      {"fg": "surfaces.ink.accent", "bg": "surfaces.ink.raised", "min": 4.5, "use": "Ink: accent text on raised cards"},
      {"fg": "surfaces.ink.text", "bg": "surfaces.ink.sunken", "min": 4.5, "use": "Ink: text in input fields"},
      {"fg": "surfaces.ink.muted", "bg": "surfaces.ink.sunken", "min": 4.5, "use": "Ink: placeholder text in input fields"},
      {"fg": "surfaces.ink.stroke", "bg": "surfaces.ink.base", "min": 3.0, "use": "Ink: input and control boundaries (non-text)"},
      {"fg": "surfaces.ink.focus", "bg": "surfaces.ink.base", "min": 3.0, "use": "Ink: focus ring (non-text)"},
      {"fg": "surfaces.chart.text", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: body text"},
      {"fg": "surfaces.chart.muted", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: secondary text"},
      {"fg": "surfaces.chart.ok", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: ok status text"},
      {"fg": "surfaces.chart.warn", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: warning status text"},
      {"fg": "surfaces.chart.crit", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: critical status text"},
      {"fg": "surfaces.chart.info", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: info text"},
      {"fg": "surfaces.chart.accent", "bg": "surfaces.chart.base", "min": 4.5, "use": "Chart: accent-as-text"},
      {"fg": "surfaces.chart.text", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: text on raised cards"},
      {"fg": "surfaces.chart.muted", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: secondary text on raised cards"},
      {"fg": "surfaces.chart.ok", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: ok text on raised cards"},
      {"fg": "surfaces.chart.warn", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: warning text on raised cards"},
      {"fg": "surfaces.chart.crit", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: critical text on raised cards"},
      {"fg": "surfaces.chart.info", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: info text on raised cards"},
      {"fg": "surfaces.chart.accent", "bg": "surfaces.chart.raised", "min": 4.5, "use": "Chart: accent text on raised cards"},
      {"fg": "surfaces.chart.text", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: text in insets and input wells"},
      {"fg": "surfaces.chart.muted", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: secondary text in insets"},
      {"fg": "surfaces.chart.ok", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: ok text in insets"},
      {"fg": "surfaces.chart.warn", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: warning text in insets"},
      {"fg": "surfaces.chart.crit", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: critical text in insets"},
      {"fg": "surfaces.chart.info", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: info text in insets"},
      {"fg": "surfaces.chart.accent", "bg": "surfaces.chart.sunken", "min": 4.5, "use": "Chart: accent text in insets"},
      {"fg": "surfaces.chart.stroke", "bg": "surfaces.chart.base", "min": 3.0, "use": "Chart: input and control boundaries (non-text)"},
      {"fg": "surfaces.chart.stroke", "bg": "surfaces.chart.raised", "min": 3.0, "use": "Chart: control boundaries on cards (non-text)"},
      {"fg": "surfaces.chart.focus", "bg": "surfaces.chart.raised", "min": 3.0, "use": "Chart: focus ring (non-text)"},
      {"fg": "brand.salmon-deep", "bg": "surfaces.chart.base", "min": 3.0, "use": "Chart: decorative salmon (large or non-text only)"},
      {"fg": "brand.on-salmon", "bg": "brand.salmon", "min": 4.5, "use": "Primary button: Ink text on salmon"},
      {"fg": "brand.on-salmon", "bg": "brand.salmon-hover", "min": 4.5, "use": "Primary button: hover"},
      {"fg": "brand.on-salmon", "bg": "brand.salmon-pressed", "min": 4.5, "use": "Primary button: pressed"},
      {"fg": "surfaces.ink.text", "bg": "surfaces.chart.info", "min": 4.5, "use": "Chart: selected rail tab and selection fill"},
      {"fg": "surfaces.chart.raised", "bg": "surfaces.chart.crit", "min": 4.5, "use": "Danger button on Chart"},
      {"fg": "surfaces.ink.sunken", "bg": "surfaces.ink.crit", "min": 4.5, "use": "Danger button on Ink"}
    ]
  },
  "spacing": {
    "unit": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radii": {
    "none": 0,
    "sm": 4,
    "md": 6,
    "lg": 10,
    "full": 9999
  },
  "elevation": {
    "card-shadow": "#0B2A3A",
    "card-shadow-alpha": 0.08,
    "card-shadow-size": 6,
    "glass-shadow-alpha": 0.35,
    "glass-shadow-size": 14
  },
  "fonts": {
    "ui": "Inter",
    "display": "Barlow Condensed",
    "opentype-features": ["tnum"],
    "files": {
      "ui-regular": "res://assets/fonts/Inter-Regular.otf",
      "ui-medium": "res://assets/fonts/Inter-Medium.otf",
      "ui-semibold": "res://assets/fonts/Inter-SemiBold.otf",
      "ui-bold": "res://assets/fonts/Inter-Bold.otf",
      "display-medium": "res://assets/fonts/BarlowCondensed-Medium.ttf",
      "display-semibold": "res://assets/fonts/BarlowCondensed-SemiBold.ttf",
      "display-fallback": "res://assets/fonts/Inter-SemiBold.otf"
    },
    "min-size": 13,
    "sizes": {
      "caption": 13,
      "small": 14,
      "body": 15,
      "lg": 18,
      "heading": 22,
      "title": 28,
      "kpi-small": 24,
      "kpi": 32,
      "display": 48
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "breakpoints": {
    "sm": 1280,
    "md": 1600,
    "lg": 1920,
    "xl": 2560
  }
}
