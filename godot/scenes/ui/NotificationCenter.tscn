[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/NotificationCenter.gd" id="1_notify"]

[node name="NotificationCenter" type="Control"]
layout_mode = 1
mouse_filter = 2
script = ExtResource("1_notify")

[node name="Panel" type="PanelContainer" parent="."]
theme_type_variation = &"Card"
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBoxContainer" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HeaderRow" type="HBoxContainer" parent="Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBoxContainer/HeaderRow"]
theme_type_variation = &"Subheading"
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Varsler"

[node name="CloseButton" type="Button" parent="Panel/Margin/VBoxContainer/HeaderRow"]
theme_type_variation = &"LargeGhostButton"
unique_name_in_owner = true
layout_mode = 2
text = "×"

[node name="ScrollContainer" type="ScrollContainer" parent="Panel/Margin/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="EntryList" type="VBoxContainer" parent="Panel/Margin/VBoxContainer/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="AnimPlayer" type="AnimationPlayer" parent="Panel"]
unique_name_in_owner = true
