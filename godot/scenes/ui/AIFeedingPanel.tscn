[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/AIFeedingPanel.gd" id="1_aifeed"]
[ext_resource type="Theme" path="res://theme/lakskongen_chart_theme.tres" id="theme_chart"]

[node name="AIFeedingPanel" type="PanelContainer"]
theme = ExtResource("theme_chart")
theme_type_variation = &"Card"
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_aifeed")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="MainScroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RootVBox" type="VBoxContainer" parent="Margin/MainScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="AiTitle" type="Label" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Heading"
unique_name_in_owner = true
layout_mode = 2
text = "AI-fôring"

[node name="StatusCard" type="PanelContainer" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Card"
layout_mode = 2

[node name="Outer" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/StatusCard"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Margin/MainScroll/RootVBox/StatusCard/Outer"]
theme_type_variation = &"CardHeader"
layout_mode = 2

[node name="StatusHeader" type="Label" parent="Margin/MainScroll/RootVBox/StatusCard/Outer/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Status"

[node name="StatusBody" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/StatusCard/Outer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CalibrationLabel" type="Label" parent="Margin/MainScroll/RootVBox/StatusCard/Outer/StatusBody"]
unique_name_in_owner = true
layout_mode = 2
text = "Kalibrering: --"

[node name="CamerasLabel" type="Label" parent="Margin/MainScroll/RootVBox/StatusCard/Outer/StatusBody"]
unique_name_in_owner = true
layout_mode = 2
text = "Kameraer: --"

[node name="AppetiteLabel" type="Label" parent="Margin/MainScroll/RootVBox/StatusCard/Outer/StatusBody"]
unique_name_in_owner = true
layout_mode = 2
text = "Appetittnivå: --"

[node name="FcrLabel" type="Label" parent="Margin/MainScroll/RootVBox/StatusCard/Outer/StatusBody"]
theme_type_variation = &"BodyInfo"
unique_name_in_owner = true
layout_mode = 2
text = "FCR-besparelse: –"

[node name="BtnInstallAi" type="Button" parent="Margin/MainScroll/RootVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Installer AI-fôringssystem"

[node name="RecipeCard" type="PanelContainer" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Card"
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Outer" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/RecipeCard"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Margin/MainScroll/RootVBox/RecipeCard/Outer"]
