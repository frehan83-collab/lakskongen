[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/StockMarketPanel.gd" id="1_stock"]

[node name="StockMarketPanel" type="PanelContainer"]
theme_type_variation = &"Card"
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_stock")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="MainScroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RootVBox" type="VBoxContainer" parent="Margin/MainScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Heading"
unique_name_in_owner = true
layout_mode = 2
text = "📈 Stock Market & IPO"

[node name="IpoCard" type="PanelContainer" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Card"
layout_mode = 2

[node name="Outer" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/IpoCard"]
layout_mode = 2
theme_override_constants/separation = 0

