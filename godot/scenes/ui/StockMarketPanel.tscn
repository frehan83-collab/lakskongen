layout_mode = 2

[node name="IpoHeader" type="Label" parent="Margin/MainScroll/RootVBox/IpoCard/Outer/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "IPO Eligibility"

[node name="IpoBody" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/IpoCard/Outer"]
layout_mode = 2
