layout_mode = 2

[node name="WeatherHeader" type="Label" parent="Margin/MainScroll/RootVBox/WeatherCard/Outer/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Current Weather Conditions"

[node name="WeatherBody" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/WeatherCard/Outer"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="WeatherStatusLabel" type="Label" parent="Margin/MainScroll/RootVBox/WeatherCard/Outer/WeatherBody"]
