[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/RASPanel.gd" id="1_ras"]

[node name="RASPanel" type="PanelContainer"]
theme_type_variation = &"Card"
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ras")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="MainScroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RootVBox" type="VBoxContainer" parent="Margin/MainScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="RasTitle" type="Label" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Heading"
unique_name_in_owner = true
layout_mode = 2
text = "RAS-anlegg Oversikt"

[node name="FacilityCard" type="PanelContainer" parent="Margin/MainScroll/RootVBox"]
theme_type_variation = &"Card"
layout_mode = 2

[node name="Outer" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/FacilityCard"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Header" type="PanelContainer" parent="Margin/MainScroll/RootVBox/FacilityCard/Outer"]
theme_type_variation = &"CardHeader"
layout_mode = 2

[node name="FacilityHeader" type="Label" parent="Margin/MainScroll/RootVBox/FacilityCard/Outer/Header"]
theme_type_variation = &"BodyInfo"
unique_name_in_owner = true
layout_mode = 2
text = "Fasiliteter"

[node name="FacilityBody" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/FacilityCard/Outer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FacilityList" type="VBoxContainer" parent="Margin/MainScroll/RootVBox/FacilityCard/Outer/FacilityBody"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="WaterChemistryLabel" type="Label" parent="Margin/MainScroll/RootVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Vannkjemi: Optimal"

[node name="ButtonRow" type="HBoxContainer" parent="Margin/MainScroll/RootVBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BtnBuildRas" type="Button" parent="Margin/MainScroll/RootVBox/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Bygg Ny RAS"

[node name="BtnMaintenance" type="Button" parent="Margin/MainScroll/RootVBox/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Vedlikehold"
