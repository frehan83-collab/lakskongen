shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// Pen walkway decking: grey anti-slip HDPE panels. Tiling albedo and normal
// tiles (1 m x 1 m) generated by blender/build_pen.py --textures; the mesh
// UV is in metres (u along the walkway, v across it). Baked AO arrives in
// the vertex colour.
uniform vec3 tint : source_color = vec3(1.0, 1.0, 1.0);
uniform sampler2D albedo_texture : source_color, hint_default_white, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_texture : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float normal_strength : hint_range(0.0, 2.0) = 0.7;
uniform float roughness : hint_range(0.0, 1.0) = 0.85;
uniform float ao_light_affect : hint_range(0.0, 1.0) = 0.35;

void fragment() {
	ALBEDO = texture(albedo_texture, UV).rgb * tint;
	NORMAL_MAP = texture(normal_texture, UV).rgb;
	NORMAL_MAP_DEPTH = normal_strength;
	ROUGHNESS = roughness;
	AO = COLOR.r;
	AO_LIGHT_AFFECT = ao_light_affect;
}
