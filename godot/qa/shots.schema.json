{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lakskongen.qa.shots/1",
  "title": "Lakskongen QA shot list",
  "description": "godot/qa/shots.json: every QA capture shot, appended by the item that adds it (roadmap P0-03, farm-types spec section 7). The capture scene named by `scene` reads the shots that name it. tests/test_farm_type_graybox.py validates the file against this schema.",
  "type": "object",
  "required": ["schema", "shots"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "lakskongen.qa.shots/1"},
    "doc": {"type": "string"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot"}
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["id", "item", "scene", "kind", "resolution", "weather", "camera", "purpose"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{2}[a-z]?_[a-z0-9_]+$"},
        "item": {"type": "string", "pattern": "^[A-Z][0-9A-Z]*-[0-9]{2}[a-z]?$"},
        "scene": {"type": "string", "pattern": "^res://.+\\.tscn$"},
        "kind": {"enum": ["graybox_read", "beauty", "ui"]},
        "resolution": {
          "type": "array",
          "items": {"type": "integer", "minimum": 320},
          "minItems": 2,
          "maxItems": 2
        },
        "scenario": {"type": "string"},
        "seed": {"type": "integer"},
        "season": {"type": "number", "minimum": 0, "maximum": 1},
        "hour": {"type": "number", "minimum": 0, "maximum": 24},
        "weather": {"enum": ["clear", "overcast", "rain", "snow", "storm", "fog"]},
        "camera": {"$ref": "#/$defs/camera"},
        "perf": {"type": "boolean"},
        "tank_shadows": {"type": "boolean"},
        "night_light": {"type": "number", "minimum": 0, "maximum": 1},
        "lid_variant": {"type": "number", "minimum": 0, "maximum": 1},
        "nav_lights": {"type": "number", "minimum": 0, "maximum": 1},
        "build_stage": {"type": "number", "minimum": 0, "maximum": 6},
        "fleet": {"type": "boolean"},
        "tug": {"type": "boolean"},
        "lineup": {"type": "boolean"},
        "measure": {"type": "boolean"},
        "plot_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "variant_of": {"type": "string"},
        "sun_elevation_deg": {"type": "number", "minimum": -20, "maximum": 60, "description": "F2-23: the shot's hour is the hour of its day when the sun, going down, stands at this elevation (deg)."},
        "air_c": {"type": "number", "minimum": -40, "maximum": 40, "description": "F2-24: the air's temperature (deg C) the weather stands at (it comes from the sim only; a staged weather has its 6 deg default)."},
        "incident": {"enum": ["Tilt", "NetTear", "MooringFailure"], "description": "F2-24: the offshore unit's open incident (the engine's OffshoreIncidentKind name); a tilt lists the unit."},
        "settle_s": {"type": "number", "minimum": 0.1, "maximum": 30, "description": "F2-24: seconds the shot waits for its particles to fill the air (default 2)."},
        "open_sea": {
          "type": "object",
          "description": "F2-21: the open sea's target, staged as a weather is (EnvironmentDirector.set_target_sea).",
          "required": ["hs", "wind_sea_hs", "swell_total_hs", "swell_tp"],
          "additionalProperties": false,
          "properties": {
            "hs": {"type": "number", "minimum": 0},
            "wind_sea_hs": {"type": "number", "minimum": 0},
            "swell_total_hs": {"type": "number", "minimum": 0},
            "swell_tp": {"type": "number", "minimum": 0}
          }
        },
        "checks": {
          "type": "array",
          "description": "F2-21/F2-23: the content checks ShowcaseCapture runs on the shot.",
          "items": {"enum": ["campus", "orange", "lights_ab", "sky", "of1", "storm", "chip", "landmarks", "first_sight", "teaser", "spray", "list", "steam"]},
          "uniqueItems": true
        },
        "pad_state": {
          "type": "object",
          "description": "F2-19: land pad id -> terrain pad_state (0 heath, 1 blasted granite); pads left out stay heath.",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "measure_pads": {"type": "boolean", "description": "F2-19: record each pad's mean CIE Lab in the frame."},
        "facilities": {
          "type": "object",
          "description": "F2-20: the farm-type QA set the presenter draws, stood in the engine through the bridge's QA verbs (the engine's own build verbs); the set only grows over a run.",
          "additionalProperties": false,
          "properties": {
            "land": {
              "type": "object",
              "description": "An HFS site on pad_a: 'operational' commissions its lots at once, a phase key builds it lot by lot and stands its projects in that phase.",
              "required": ["lots", "phase"],
              "additionalProperties": false,
              "properties": {
                "lots": {"type": "integer", "minimum": 1, "maximum": 4},
                "phase": {"enum": ["site_works", "tank_rings", "treatment_hall", "sea_works", "first_tanks", "completion", "operational"]},
                "progress": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "land_b": {
              "type": "object",
              "description": "A second HFS site, on pad_b (wave4b review: the second pad's layout): built lot by lot through the engine's verbs, 'operational' stands its projects complete.",
              "required": ["lots", "phase"],
              "additionalProperties": false,
              "properties": {
                "lots": {"type": "integer", "minimum": 1, "maximum": 2},
                "phase": {"enum": ["site_works", "tank_rings", "treatment_hall", "sea_works", "first_tanks", "completion", "operational"]},
                "progress": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "post_smolt": {
              "type": "object",
              "description": "A post-smolt site on pad_delta, built.",
              "required": ["modules"],
              "additionalProperties": false,
              "properties": {"modules": {"type": "integer", "minimum": 1, "maximum": 4}}
            },
            "offshore": {
              "type": "object",
              "description": "An OF1-class unit on off_1, contracted on a QA award and stood in a phase of its project.",
              "required": ["phase"],
              "additionalProperties": false,
              "properties": {
                "phase": {"enum": ["yard_contract", "hull", "voyage", "tow", "mooring", "commissioning", "operational"]},
                "progress": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        },
        "perf_units": {
          "type": "array",
          "description": "F2-20: with perf, only these QA-set units are shown in the A/B's 'on' frame, so one unit's own draw calls are measured.",
          "items": {"enum": ["land", "post_smolt", "offshore"]},
          "uniqueItems": true
        },
        "state": {"type": "string", "description": "A UI shot's game state, named by its capture scene (U2-01: map, build_refused, auction_preview, auction_live, auction_won, build_new_zone, built_view)."},
        "purpose": {"type": "string", "minLength": 10}
      }
    },
    "camera": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["home", "focus", "target", "first_sight", "teaser"]},
        "t": {"type": "number", "minimum": 0, "description": "first_sight, teaser: the sequence's time (s)."},
        "reduced": {"type": "boolean", "description": "first_sight, teaser: the reduced-motion still."},
        "target": {"type": "string"},
        "distance_m": {"type": "number", "exclusiveMinimum": 0},
        "pitch_deg": {"type": "number", "minimum": -90, "maximum": 0},
        "yaw_deg": {"type": "number"},
        "focus_y": {"type": "number"},
        "offset": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      }
    }
  }
}
