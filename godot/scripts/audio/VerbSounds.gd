class_name VerbSounds
extends RefCounted

## The verbs' sound cues (roadmap Au2-01): which cue a player's action or an
## event from the typed event bus plays. Pure mapping, so it is testable
## without audio; AudioController plays the cue (once, however many signals
## carry the same action).
##
## The cues are generated by tools/audio/gen_audio.py (cues.py): stock,
## feed plan, delouse, auction (the gavel) and storm (thunder and a gust).
## The harvest's payoff is the ConsequenceDirector's stinger (U2-05: one per
## harvest, however many slaughter days), so it is not repeated here.

## Cue key -> file (MusicLibrary.VERB_SFX holds the same paths).
const STOCK := "stock"
const FEED_PLAN := "feed_plan"
const DELOUSE := "delouse"
const HARVEST := "harvest"
const AUCTION := "auction"
const STORM := "storm"

## Player actions (SimBridge.pen_action_completed / GameBridge.FarmActionCompleted
## action ids) -> cue. Only a success plays.
const ACTION_CUES := {
	"stock_smolts": STOCK,
	"feed_plan": FEED_PLAN,
	"delouse": DELOUSE,
	"delousing": DELOUSE,
}

## Event-bus types (GameEventCatalog ids) -> cue: the auction's verdict and
## the storm's warnings and damage.
const EVENT_CUES := {
	"licence_auction_won": AUCTION,
	"licence_auction_lost": AUCTION,
	"storm_forecast": STORM,
	"storm_swell_forecast": STORM,
	"storm_damage": STORM,
}

## An event this many days old when it arrives is history (the same rule as
## ConsequenceDirector.STALE_EVENT_DAYS): logged, not played.
const STALE_EVENT_DAYS := 3


static func for_action(action: String, success: bool) -> String:
	return str(ACTION_CUES.get(action, "")) if success else ""


static func for_event(event: Dictionary, today: int) -> String:
	if today >= 0 and today - int(event.get("day", today)) >= STALE_EVENT_DAYS:
		return ""
	return str(EVENT_CUES.get(str(event.get("type", "")), ""))
