{
	"mcpServers": {
		"blender": {
			"command": "uv",
			"args": [
				"--directory",
				"${HOME}/blender_mcp/mcp",
				"run",
				"blender-mcp"
			]
		},
		"godot": {
			"command": "npx",
			"args": [
				"-y",
				"@npgamedev/godot-mcp-server"
			],
			"env": {
				"GODOT_MCP_PROJECT_PATH": "${HOME}/lakskongen/godot"
			}
		}
	}
}
