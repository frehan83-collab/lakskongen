{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakskongen.local/schemas/mods/research.schema.json",
  "title": "Lakskongen Mod Research Nodes",
  "description": "Schema for mod research node definitions (research_*.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "branch": {
        "type": "string",
        "enum": ["Biology", "Technology", "Sustainability", "Processing", "Expansion", "Genetics", "Automation", "Environment", "Health", "Nutrition"]
      },
      "tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "cost_nok": {
        "type": "number",
        "minimum": 0
      },
      "research_days": {
        "type": "integer",
        "minimum": 1
      },
      "prerequisites": {
        "type": "array",
        "items": { "type": "string" }
      },
      "effects": {
        "type": "object",
        "description": "Research effect keys (e.g. growth_rate_bonus, fcr_reduction)"
      }
    },
    "additionalProperties": false
  }
}
