{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakskongen.local/schemas/mods/scenarios.schema.json",
  "title": "Lakskongen Mod Scenarios",
  "description": "Schema for mod scenario definitions (scenarios_*.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "starting_capital_nok": {
        "type": "number"
      },
      "starting_region": {
        "type": "string"
      },
      "difficulty": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "win_condition": {
        "type": "string"
      },
      "initial_balance_nok": {
        "type": "number"
      },
      "starting_fish_count": {
        "type": "integer",
        "minimum": 0
      },
      "initial_events": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "additionalProperties": false
  }
}
